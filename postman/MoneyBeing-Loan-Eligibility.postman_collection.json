{
  "info": {
    "_postman_id": "9a1b2c3d-4e5f-6a7b-8c9d-0e1f2a3b4c5d",
    "name": "MoneyBeing Loan Eligibility & Lead Management System",
    "description": "Production-grade REST API collection for MoneyBeing Loan Eligibility & Lead Management System including Authentication, Customer Lead Application & BRE Engine, Lead Management, Dashboard KPIs, and Dynamic BRE Rule Configuration.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Admin Login (Sets Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.environment.set('access_token', jsonData.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"AdminPassword123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Customer Loan Application & BRE",
      "item": [
        {
          "name": "Submit Eligible Loan Lead",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.lead_id) {",
                  "    pm.environment.set('lead_id', jsonData.lead_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"full_name\": \"Rohan Sharma\",\n    \"mobile\": \"9876547500\",\n    \"email\": \"rohan@example.com\",\n    \"date_of_birth\": \"1992-05-15\",\n    \"city\": \"Mumbai\",\n    \"pincode\": \"400001\",\n    \"loan_type\": \"Home Loan\",\n    \"employment_type\": \"Salaried\",\n    \"monthly_income\": 75000,\n    \"loan_amount\": 2000000,\n    \"property_value\": 3500000,\n    \"consent\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/leads",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "leads"
              ]
            }
          }
        },
