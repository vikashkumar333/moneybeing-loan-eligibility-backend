    {
      "name": "5. Business Rule Engine CRUD (Admin)",
      "item": [
        {
          "name": "List All Active/Inactive BRE Rules",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/bre-rules",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "bre-rules"
              ]
            }
          }
        },
        {
          "name": "Create New BRE Rule",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.environment.set('rule_id', jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"rule_name\": \"Minimum Income Tier 1\",\n    \"field_name\": \"monthly_income\",\n    \"operator\": \">=\",\n    \"rule_value\": \"45000\",\n    \"failure_message\": \"Applicant income below tier 1 threshold of 45,000\",\n    \"is_active\": true,\n    \"priority\": 6\n}"
            },
            "url": {
              "raw": "{{base_url}}/bre-rules",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "bre-rules"
              ]
            }
          }
        },
        {
          "name": "Update BRE Rule Threshold",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"rule_value\": \"50000\",\n    \"failure_message\": \"Applicant income below updated threshold of 50,000\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/bre-rules/{{rule_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "bre-rules",
                "{{rule_id}}"
              ]
            }
          }
        },
        {
          "name": "Toggle BRE Rule Status (Activate/Deactivate)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"is_active\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/bre-rules/{{rule_id}}/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "bre-rules",
                "{{rule_id}}",
                "status"
              ]
            }
          }
        },
        {
          "name": "Soft Delete BRE Rule",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/bre-rules/{{rule_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "bre-rules",
                "{{rule_id}}"
              ]
            }
          }
        }
      ]
