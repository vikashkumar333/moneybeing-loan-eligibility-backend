    {
      "name": "3. Lead Management (Admin)",
      "item": [
        {
          "name": "List Paginated Leads",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/leads?page=1&page_size=20&sort_by=created_at&sort_order=desc",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "leads"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "20"
                },
                {
                  "key": "sort_by",
                  "value": "created_at"
                },
                {
                  "key": "sort_order",
                  "value": "desc"
                }
              ]
            }
          }
        },
        {
          "name": "Search & Filter Leads",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/leads?search=Rohan&bre_status=Eligible&loan_type=Home Loan",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "leads"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "Rohan"
                },
                {
                  "key": "bre_status",
                  "value": "Eligible"
                },
                {
                  "key": "loan_type",
                  "value": "Home Loan"
                }
              ]
            }
          }
        },
        {
          "name": "Get Lead Detail with BRE Results",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/leads/{{lead_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "leads",
                "{{lead_id}}"
              ]
            }
          }
        }
      ]
